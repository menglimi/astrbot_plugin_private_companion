{
  "performance": {
    "description": "性能模式（低配置设备）",
    "hint": "放在官方配置页顶部。开启并重载插件后，陪伴小屋页面只显示轻量状态页，不再加载 3D 小屋、全部样式与工作区脚本；插件同时跳过陪伴小屋的页面管理路由注册。聊天、记忆与已配置的主动功能继续运行。关闭并重载即可恢复小屋。",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用性能模式",
        "hint": "适合低配置设备或远程访问卡顿的环境。保存后请重载插件；性能模式下如需修改高级设置，请先关闭本项并重载。",
        "type": "bool",
        "default": false
      }
    }
  },
  "storage": {
    "description": "资料存储与清理",
    "hint": "存储位置变更会在重启插件时迁移 V2 资料；清理策略只管理已完成的备份快照。",
    "invisible": true,
    "type": "object",
    "items": {
      "path": {
        "description": "资料存储位置",
        "hint": "留空使用 AstrBot 默认目录；填写其他绝对目录可将插件资料迁移到其他磁盘。",
        "type": "string",
        "default": ""
      },
      "backup_path": {
        "description": "备份快照位置",
        "hint": "留空跟随运行资料位置；填写其他绝对目录后，快照将独立存放。",
        "type": "string",
        "default": ""
      },
      "retention_count": {
        "description": "保留最近备份数量",
        "type": "int",
        "default": 10
      },
      "retention_days": {
        "description": "备份保留天数",
        "type": "int",
        "default": 90
      }
    }
  },
  "staging": {
    "description": "兼容设置（高级）",
    "hint": "旧版单目标配置，仅用于升级时迁移；V2 运行状态由「陪伴小屋 → 账号与会话」统一管理。",
    "invisible": true,
    "type": "object",
    "items": {
      "enabled": {
        "description": "旧版单目标开关（升级兼容）",
        "hint": "新版加载时会迁移到共享宿主配置。",
        "type": "bool",
        "default": false
      },
      "profile_id": {
        "description": "独立 Profile ID",
        "hint": "仅可使用小写字母、数字、下划线和连字符。每个 ID 对应独立的 V2 数据；账号、私聊对象与人格由核心管理员窗口绑定。",
        "type": "string",
        "default": "main"
      },
      "delivery_mode": {
        "description": "投递形态（旧字段）",
        "hint": "仅保留旧配置兼容：正式宿主固定使用 OneBot 原生私聊发送，该字段不再影响行为。",
        "type": "string",
        "options": [
          "onebot_private",
          "preview"
        ],
        "default": "onebot_private"
      }
    }
  },
  "target": {
    "description": "旧版绑定（高级）",
    "hint": "新安装不必填这里：在私聊里发送 companion_bind 即可绑定会话对象，身份由 Bot 登录号与所选人格自动派生。这一段只为兼容已填过的安装保留——填了就按填的走，留空则由引导派生。",
    "type": "object",
    "invisible": true,
    "items": {
      "platform_id": {
        "description": "OneBot 平台实例 ID",
        "type": "string",
        "default": "default"
      },
      "account_id": {
        "description": "Bot QQ 账号",
        "type": "string",
        "default": ""
      },
      "participant_id": {
        "description": "测试参与者 QQ",
        "hint": "留空则由引导绑定；只有这个账号发给所选 Bot 的私聊纯文本会被接管。",
        "type": "string",
        "default": ""
      },
      "bot_id": {
        "description": "V2 Bot ID",
        "type": "string",
        "default": "staging-bot",
        "hint": "留空时由 Bot 登录号派生（bot-<账号>）。"
      },
      "role_id": {
        "description": "V2 角色 ID",
        "type": "string",
        "default": "staging-role",
        "hint": "留空时由账号与人格派生；相同账号+人格共享记忆，不同则各自独立。"
      },
      "persona_id": {
        "description": "AstrBot 人格 ID",
        "hint": "留空表示随目标会话当前实际选择的人格。",
        "type": "string",
        "default": ""
      }
    }
  },
  "multi_host": {
    "description": "账号与会话（由小屋管理）",
    "hint": "账号、原生人格、私聊／群聊窗口及其绑定关系请在「陪伴小屋 → 账号与会话」管理。此处配置自动隐藏但仍由插件读取。",
    "type": "object",
    "invisible": true,
    "items": {
      "enabled": {
        "description": "启用 V2 接管",
        "type": "bool",
        "default": false
      },
      "installation_id": {
        "description": "共享安装 ID",
        "hint": "安装 ID 一旦初始化就作为记忆、身份和恢复记录的稳定命名空间。",
        "type": "string",
        "default": "main"
      },
      "targets": {
        "description": "私聊目标列表",
        "hint": "每个目标由平台、Bot 登录账号和私聊参与者组成；target_id 只能用于管理定位。",
        "type": "template_list",
        "default": [],
        "templates": {
          "private_target": {
            "name": "私聊目标",
            "items": {
              "target_id": {
                "description": "目标 ID",
                "type": "string",
                "default": "target-1"
              },
              "platform_id": {
                "description": "OneBot 平台实例 ID",
                "type": "string",
                "default": "default"
              },
              "account_id": {
                "description": "Bot QQ 账号",
                "type": "string",
                "default": ""
              },
              "bot_id": {
                "description": "逻辑 Bot ID",
                "type": "string",
                "default": "bot-1"
              },
              "participant_id": {
                "description": "私聊参与者 QQ",
                "type": "string",
                "default": ""
              }
            }
          }
        }
      },
      "personas": {
        "description": "原生人格映射列表",
        "hint": "persona_id 是 AstrBot 当前人格标识，role_id 是 V2 记忆归属。相同 role_id 会共享记忆。",
        "type": "template_list",
        "default": [],
        "templates": {
          "persona_mapping": {
            "name": "人格映射",
            "items": {
              "bot_id": {
                "description": "逻辑 Bot ID",
                "type": "string",
                "default": "bot-1"
              },
              "persona_id": {
                "description": "AstrBot 人格 ID",
                "type": "string",
                "default": "default"
              },
              "role_id": {
                "description": "V2 角色 ID",
                "hint": "要隔离记忆请使用不同值。",
                "type": "string",
                "default": "role-1"
              }
            }
          }
        }
      },
      "group_targets": {
        "description": "群聊目标列表",
        "hint": "仅接管明确配置的群号中的文本和账号提及。按实际群消息认证发言者，支持 AstrBot 群会话及成员独立会话；群聊与私聊使用各自配置的目标及按人权限。",
        "type": "template_list",
        "default": [],
        "templates": {
          "group_target": {
            "name": "群聊目标",
            "items": {
              "target_id": {
                "description": "目标 ID",
                "type": "string",
                "default": "group-1"
              },
              "platform_id": {
                "description": "OneBot 平台实例 ID",
                "type": "string",
                "default": "default"
              },
              "account_id": {
                "description": "Bot QQ 账号",
                "type": "string",
                "default": ""
              },
              "bot_id": {
                "description": "逻辑 Bot ID",
                "type": "string",
                "default": "bot-1"
              },
              "group_id": {
                "description": "群号",
                "type": "string",
                "default": ""
              }
            }
          }
        }
      },
      "capabilities": {
        "description": "目标公共能力",
        "hint": "memory.read/propose/reflect/subscribe 用于记忆公共链；relationship.memory.read/propose 允许角色提交待审阅的关系与情绪提案，不授予自动采用权限。已有明确能力清单不会自动扩权。",
        "type": "list",
        "items": {
          "type": "string"
        },
        "default": [
          "configuration.read",
          "conversation.reply",
          "memory.propose",
          "memory.read",
          "memory.reflect",
          "memory.subscribe",
          "text"
        ]
      },
      "delivery_mode": {
        "description": "私聊投递形态（旧字段）",
        "hint": "仅保留旧配置兼容：正式宿主固定使用 OneBot 原生私聊发送，该字段不再影响行为。",
        "type": "string",
        "options": [
          "onebot_private",
          "preview"
        ],
        "default": "onebot_private"
      },
      "group_delivery_mode": {
        "description": "群投递形态（旧字段）",
        "hint": "仅为旧配置兼容保留，不再控制投递；群消息始终走已配置的 OneBot 原生渠道。运行前预览由操作级草稿接口决定。",
        "type": "string",
        "invisible": true,
        "options": [
          "onebot_group",
          "preview"
        ],
        "default": "onebot_group"
      }
    }
  },
  "model": {
    "description": "模型｜提供方、任务与费率",
    "hint": "单目标和多目标共用本组。模型调用由所选 AstrBot Provider 执行；初始化只保存 provider 指纹，不保存 API Key、Endpoint 或完整 provider 配置。",
    "type": "object",
    "items": {
      "provider_id": {
        "description": "插件任务模型 Provider",
        "hint": "后台维护默认使用此模型。回复与主动消息默认跟随对应 AstrBot 会话的对话模型；陪伴小屋中明确设置的任务模型优先。",
        "_special": "select_provider",
        "type": "string",
        "default": ""
      },
      "task_prompt": {
        "description": "任务提示",
        "hint": "当前 AstrBot 人格提示仍由宿主读取并单独校验；这里补充本次回复任务的约束。",
        "type": "text",
        "default": "沿用当前 AstrBot 人格，先回应本轮真正的问题或话题。自然、具体地说清意思；只使用本轮输入和有依据的材料，不补造事实。按任务需要调整长短与格式，闲聊不复述、不写客服式收尾。"
      },
      "fallback_provider_id": {
        "description": "回复任务的回退 Provider",
        "hint": "留空时回退到当前窗口模型；从 AstrBot 已加载的文本 Provider 中选择备用项。仅当前一 Provider 确认未开始时回退；开启拒答替代后，明确拒答也可切换。流式中断和结果未知不会重试。",
        "_special": "select_provider",
        "type": "string",
        "default": ""
      },
      "fallback_on_refusal": {
        "description": "明确拒答后尝试备用模型",
        "hint": "仅识别 Provider 的拒答标记或内容过滤结束信号；普通文本、解析失败和未知结果不触发替代。原模型的实际费用仍计入预算。需在回复任务中选择备用 Provider。",
        "type": "bool",
        "default": false
      },
      "replacement_rules": {
        "description": "回复模型替换规则 JSON",
        "hint": "默认 [] 关闭。示例：[{\"id\":\"code\",\"provider_id\":\"AstrBot Provider ID\",\"keywords\":[\"写代码\"],\"priority\":10}]。可加 model 覆盖模型名，费用按全局费率估算；time_window 支持 timezone、start/end（HH:MM）及 weekdays（0=周一）。仅匹配本轮消息，关键词和时段同时配置时须同时命中；同一任务的工具续答保持首次选择。",
        "type": "text",
        "default": "[]"
      },
      "max_output_tokens": {
        "description": "最大输出 Token",
        "hint": "这是各任务的默认输出预算，不是所选 Provider 的能力上限：陪伴小屋的任务模型编辑器可按任务改到 Provider 允许的上限（未单独声明上限的 Provider 取 65536）。思考型模型把思考也算进这份预算，正文常在几百字处被截断，按任务调大即可。",
        "type": "int",
        "default": 2048
      },
      "streaming": {
        "description": "对话模型使用流式请求",
        "hint": "启用后按分段配置选择收齐再发送或边生成边发送。中断时停止剩余内容，已确认发出的段落不重发；后台书写保持完整响应协议。",
        "type": "bool",
        "default": false
      },
      "maximum_input_estimate": {
        "description": "最大输入估算 Token",
        "type": "int",
        "default": 131072
      },
      "output_parameter": {
        "description": "输出限制参数",
        "type": "string",
        "options": [
          "max_tokens",
          "max_completion_tokens"
        ],
        "default": "max_tokens"
      },
      "input_microusd_per_million": {
        "description": "输入费率（microUSD / 百万 Token）",
        "type": "int",
        "default": 0
      },
      "cached_input_microusd_per_million": {
        "description": "缓存输入费率（microUSD / 百万 Token）",
        "type": "int",
        "default": 0
      },
      "output_microusd_per_million": {
        "description": "输出费率（microUSD / 百万 Token）",
        "type": "int",
        "default": 0
      }
    }
  },
  "segmentation": {
    "description": "回复｜文字分段",
    "hint": "默认采用 V1 当前全局分段配置：按分段词拆分，最短 5 字、最多 5 条、500 字以内自动分段；模型边界默认关闭。已保存的会话设置优先。分段节奏与清理词在陪伴小屋的表达页配置。",
    "type": "object",
    "items": {
      "streaming_mode": {
        "description": "流式分段发送方式",
        "hint": "buffered：收齐并校验后再分段发送；incremental：流式生成时按分段词、正则或模型边界逐段发送。分段字数阈值在流式中按当前已收到的正文计算；已发送的段落不回改。语音、图片组合回复及未按协议输出的模型收齐后发送。",
        "type": "string",
        "options": [
          "buffered",
          "incremental"
        ],
        "default": "buffered"
      },
      "enabled": {
        "description": "开启分段发送",
        "type": "bool",
        "default": true
      },
      "llm_controlled": {
        "description": "允许模型决定分段",
        "type": "bool",
        "default": false
      },
      "rule_mode": {
        "description": "补充分段方式",
        "type": "string",
        "options": [
          "words",
          "regex",
          "sentences",
          "paragraphs"
        ],
        "default": "words"
      },
      "split_words": {
        "description": "分段标记列表",
        "hint": "默认按句末标点分段，不在逗号处拆开连贯表达；匹配到的分隔符保留在上一段，之后按清理词处理。",
        "type": "text",
        "default": "[\"。\", \"？\", \"！\", \"~\", \"～\", \"?\", \".\", \"!\", \";\", \"；\", \"……\", \"）\", \"…\"]"
      },
      "match_width_variants": {
        "description": "分段词匹配全角/半角变体",
        "type": "bool",
        "default": true
      },
      "rule_regex": {
        "description": "正则分段表达式",
        "type": "text",
        "default": "(?<=[。！？!?…~～])\\s*|\\n+",
        "hint": "仅在正则分段方式下使用；按词分段使用上方列表。支持保留标点的零宽边界。"
      },
      "threshold": {
        "description": "自动规则分段最大正文长度；更长内容保持整段",
        "type": "int",
        "default": 500
      },
      "min_segment_chars": {
        "description": "短消息合并参考长度",
        "type": "int",
        "default": 5
      },
      "max_segments": {
        "description": "最多消息数",
        "hint": "范围 1–64，超出时合并相邻段，保留完整正文。",
        "type": "int",
        "default": 5
      },
      "prompt": {
        "description": "自定义模型分段提示",
        "hint": "留空使用默认提示，最多 4000 字。{{split_marker}} 会替换成完整分段标记。",
        "type": "text",
        "default": ""
      }
    }
  },
  "voice_reply": {
    "description": "回复｜语音强化",
    "hint": "单目标和多目标共用，默认关闭。支持触发条件、模型选句、分段范围、组件位置和独立会话冷却。修改后重载插件；已生成的回复按生成时计划投递，合成失败保留文字。",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用语音回复",
        "type": "bool",
        "default": false,
        "invisible": true
      },
      "trigger_mode": {
        "description": "语音触发",
        "type": "string",
        "options": [
          "always",
          "request",
          "adaptive"
        ],
        "default": "always",
        "hint": "always 总是尝试；request 仅用户请求语音时；adaptive 由模型用语音标签选句。"
      },
      "generation_mode": {
        "description": "朗读文本来源",
        "type": "string",
        "options": [
          "plain",
          "model_tag"
        ],
        "default": "plain",
        "hint": "plain 朗读选中的可见段落；model_tag 只朗读模型用 <pc_tts> 包裹的内容。"
      },
      "segment_mode": {
        "description": "语音分段范围",
        "type": "string",
        "options": [
          "whole",
          "each",
          "first",
          "last"
        ],
        "default": "whole",
        "hint": "whole 等全部文字收齐后合成一次，语气和上下文更完整；each 每段分别合成，出音更早但会切碎语义。"
      },
      "delivery_mode": {
        "description": "发送形态",
        "type": "string",
        "options": [
          "voice_and_text",
          "voice_only"
        ],
        "default": "voice_and_text",
        "hint": "voice_only 仅在合成成功且朗读覆盖整段文字时隐藏文字；部分朗读或合成失败保留完整文字。"
      },
      "position": {
        "description": "语音组件位置",
        "type": "string",
        "options": [
          "after_media",
          "after_text",
          "before_text"
        ],
        "default": "after_media",
        "hint": "after_media 在图片后，after_text 在文字后图片前，before_text 在文字前。"
      },
      "language": {
        "description": "朗读语种",
        "type": "string",
        "options": [
          "zh",
          "ja",
          "en"
        ],
        "default": "zh"
      },
      "foreign_text_mode": {
        "description": "外语可见文字",
        "type": "string",
        "options": [
          "original",
          "translation",
          "bilingual"
        ],
        "default": "original",
        "hint": "与模型选句配合：translation 显示标签外译文，缺少译文时保留该句原文；bilingual 同时显示原文与译文。"
      },
      "probability": {
        "description": "基础触发概率",
        "type": "float",
        "default": 1.0,
        "invisible": true
      },
      "private_probability": {
        "description": "私聊概率覆盖",
        "type": "float",
        "default": -1.0,
        "hint": "-1 继承基础概率，范围 0–1。",
        "invisible": true
      },
      "group_probability": {
        "description": "群聊概率覆盖",
        "type": "float",
        "default": -1.0,
        "hint": "-1 继承基础概率，范围 0–1。",
        "invisible": true
      },
      "cooldown_seconds": {
        "description": "会话冷却秒数",
        "type": "int",
        "default": 0
      },
      "max_speech_chars": {
        "description": "单段最长朗读字符",
        "type": "int",
        "default": 1800
      },
      "timeout_seconds": {
        "description": "合成超时秒数",
        "type": "int",
        "default": 30
      },
      "trigger_keywords": {
        "description": "请求触发词",
        "type": "text",
        "default": "",
