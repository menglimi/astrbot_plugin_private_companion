{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:companion:schema:calendar-story-projection:v1",
  "title": "A short-lived audience-filtered narrative projection",
  "type": "object",
  "properties": {
    "schema_version": { "const": "companion.story-projection.v1" },
    "projection_id": { "$ref": "urn:companion:schema:common:v1#/$defs/token" },
    "owner_ref": { "$ref": "urn:companion:schema:common:v1#/$defs/token" },
    "scope": { "$ref": "urn:companion:schema:runtime-scope:v1" },
    "audience": { "enum": ["session", "user", "global"] },
    "source_event_refs": { "type": "array", "items": { "$ref": "urn:companion:schema:common:v1#/$defs/token" }, "minItems": 1, "maxItems": 16 },
    "reality_mode": { "enum": ["simulated", "observed", "mixed"] },
    "segments": { "type": "array", "items": { "$ref": "#/$defs/segment" }, "minItems": 1, "maxItems": 8 },
    "projection_revision": { "$ref": "urn:companion:schema:common:v1#/$defs/revision" },
    "valid_until": { "$ref": "urn:companion:schema:common:v1#/$defs/time" },
    "supersedes": { "anyOf": [{ "$ref": "urn:companion:schema:common:v1#/$defs/token" }, { "type": "null" }] }
  },
  "required": ["schema_version", "projection_id", "owner_ref", "scope", "audience", "source_event_refs", "reality_mode", "segments", "projection_revision", "valid_until", "supersedes"],
  "additionalProperties": false,
  "$defs": {
    "segment": {
      "type": "object",
      "properties": {
        "segment_id": { "$ref": "urn:companion:schema:common:v1#/$defs/token" },
        "activity_ref": { "anyOf": [{ "$ref": "urn:companion:schema:common:v1#/$defs/token" }, { "type": "null" }] },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "shareability": { "enum": ["private", "user_safe", "global_safe"] },
        "expires_at": { "$ref": "urn:companion:schema:common:v1#/$defs/time" }
      },
      "required": ["segment_id", "activity_ref", "text", "shareability", "expires_at"],
      "additionalProperties": false
    }
  }
}
