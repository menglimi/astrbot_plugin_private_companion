{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:companion:schema:sharing-context-contribution:v1",
  "title": "Typed bounded context contribution with explicit sharing partition",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "companion.context-contribution.v1"
    },
    "required_features": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*@[1-9][0-9]*$"
      },
      "uniqueItems": true,
      "contains": {
        "const": "companion.sharing@1"
      }
    },
    "contribution_id": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "source_plugin": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "source_event_id": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "scope": {
      "$ref": "urn:companion:schema:runtime-scope:v1"
    },
    "sharing_mode": {
      "$ref": "urn:companion:schema:sharing-binding:v1#/$defs/mode"
    },
    "sharing_anchor": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "sharing_policy_revision": {
      "$ref": "urn:companion:schema:common:v1#/$defs/revision"
    },
    "lane": {
      "enum": [
        "identity",
        "relationship",
        "scene",
        "memory",
        "affect",
        "affordance",
        "safety"
      ]
    },
    "content_type": {
      "enum": [
        "fact",
        "observation",
        "memory",
        "media",
        "task",
        "suggestion"
      ]
    },
    "content": {
      "anyOf": [
        {
          "$ref": "urn:companion:schema:common:v1#/$defs/semantic"
        },
        {
          "type": "null"
        }
      ]
    },
    "resource_ref": {
      "anyOf": [
        {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:companion:schema:common:v1#/$defs/evidence"
      },
      "minItems": 1
    },
    "authority": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "visibility": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "purpose": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "redaction": {
      "enum": [
        "none",
        "masked",
        "summary_only"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "valid_from": {
      "$ref": "urn:companion:schema:common:v1#/$defs/time"
    },
    "expires_at": {
      "$ref": "urn:companion:schema:common:v1#/$defs/time"
    },
    "budget": {
      "$ref": "urn:companion:schema:common:v1#/$defs/budget"
    },
    "extensions": {
      "$ref": "urn:companion:schema:common:v1#/$defs/extensions"
    }
  },
  "required": [
    "schema_version",
    "required_features",
    "contribution_id",
    "source_plugin",
    "source_event_id",
    "scope",
    "sharing_mode",
    "sharing_anchor",
    "sharing_policy_revision",
    "lane",
    "content_type",
    "content",
    "resource_ref",
    "evidence_refs",
    "authority",
    "visibility",
    "purpose",
    "redaction",
    "confidence",
    "valid_from",
    "expires_at",
    "budget",
    "extensions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "sharing_mode": {
            "const": "session"
          }
        }
      },
      "then": {
        "properties": {
          "scope": {
            "properties": {
              "conversation_ref": {
                "$ref": "urn:companion:schema:common:v1#/$defs/token"
              },
              "session_id": {
                "$ref": "urn:companion:schema:common:v1#/$defs/token"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sharing_mode": {
            "const": "user"
          }
        }
      },
      "then": {
        "properties": {
          "scope": {
            "properties": {
              "platform": {
                "$ref": "urn:companion:schema:common:v1#/$defs/token"
              },
              "account_id": {
                "$ref": "urn:companion:schema:common:v1#/$defs/token"
              },
              "user_id": {
                "$ref": "urn:companion:schema:common:v1#/$defs/token"
              }
            }
          }
        }
      }
    },
    {
      "anyOf": [
        {
          "properties": {
            "content": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "resource_ref": {
              "type": "string"
            }
          }
        }
      ]
    }
  ]
}
