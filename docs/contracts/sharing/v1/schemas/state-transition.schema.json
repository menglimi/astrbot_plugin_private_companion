{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:companion:schema:sharing-state-transition:v1",
  "title": "Owner-reviewed state proposal; domain patch requires separate validation",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "companion.state-transition-proposal.v1"
    },
    "required_features": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*@[1-9][0-9]*$"
      },
      "uniqueItems": true,
      "contains": {
        "const": "companion.sharing@1"
      }
    },
    "proposal_id": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "trace_id": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "scope": {
      "$ref": "urn:companion:schema:runtime-scope:v1"
    },
    "sharing_mode": {
      "$ref": "urn:companion:schema:sharing-binding:v1#/$defs/mode"
    },
    "sharing_anchor": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "sharing_policy_revision": {
      "$ref": "urn:companion:schema:common:v1#/$defs/revision"
    },
    "owner_ref": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "target_state": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "expected_revision": {
      "$ref": "urn:companion:schema:common:v1#/$defs/revision"
    },
    "patch_schema": {
      "type": "string",
      "pattern": "^urn:[^\\s]+$"
    },
    "patch": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:companion:schema:common:v1#/$defs/evidence"
      },
      "minItems": 1
    },
    "visibility": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "purpose": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "valid_until": {
      "$ref": "urn:companion:schema:common:v1#/$defs/time"
    },
    "idempotency_key": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "budget": {
      "$ref": "urn:companion:schema:common:v1#/$defs/budget"
    },
    "extensions": {
      "$ref": "urn:companion:schema:common:v1#/$defs/extensions"
    }
  },
  "required": [
    "schema_version",
    "required_features",
    "proposal_id",
    "trace_id",
    "scope",
    "sharing_mode",
    "sharing_anchor",
    "sharing_policy_revision",
    "owner_ref",
    "target_state",
    "expected_revision",
    "patch_schema",
    "patch",
    "evidence_refs",
    "visibility",
    "purpose",
    "valid_until",
    "idempotency_key",
    "budget",
    "extensions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "sharing_mode": {
            "const": "session"
          }
        }
      },
      "then": {
        "properties": {
          "scope": {
            "properties": {
              "conversation_ref": {
                "$ref": "urn:companion:schema:common:v1#/$defs/token"
              },
              "session_id": {
                "$ref": "urn:companion:schema:common:v1#/$defs/token"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sharing_mode": {
            "const": "user"
          }
        }
      },
      "then": {
        "properties": {
          "scope": {
            "properties": {
              "platform": {
                "$ref": "urn:companion:schema:common:v1#/$defs/token"
              },
              "account_id": {
                "$ref": "urn:companion:schema:common:v1#/$defs/token"
              },
              "user_id": {
                "$ref": "urn:companion:schema:common:v1#/$defs/token"
              }
            }
          }
        }
      }
    }
  ]
}
