{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:companion:schema:affect-event:v1",
  "title": "Evidence-backed short-lived affect event",
  "type": "object",
  "properties": {
    "schema_version": { "const": "companion.affect-event.v1" },
    "event_id": { "$ref": "urn:companion:schema:common:v1#/$defs/token" },
    "trace_id": { "$ref": "urn:companion:schema:common:v1#/$defs/token" },
    "scope": { "$ref": "urn:companion:schema:runtime-scope:v1" },
    "actor_ref": { "$ref": "urn:companion:schema:common:v1#/$defs/token" },
    "target_ref": { "$ref": "urn:companion:schema:common:v1#/$defs/token" },
    "quoted_target_ref": { "anyOf": [{ "$ref": "urn:companion:schema:common:v1#/$defs/token" }, { "type": "null" }] },
    "event_class": { "enum": ["ordinary", "relationship", "repair", "boundary", "safety", "observation"] },
    "valence": { "type": "number", "minimum": -1, "maximum": 1 },
    "arousal": { "type": "number", "minimum": 0, "maximum": 1 },
    "vulnerability": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "occurred_at": { "$ref": "urn:companion:schema:common:v1#/$defs/time" },
    "valid_until": { "$ref": "urn:companion:schema:common:v1#/$defs/time" },
    "dedupe_key": { "$ref": "urn:companion:schema:common:v1#/$defs/token" },
    "evidence_refs": { "type": "array", "items": { "$ref": "urn:companion:schema:common:v1#/$defs/evidence" }, "minItems": 1, "maxItems": 8 },
    "supersedes": { "anyOf": [{ "$ref": "urn:companion:schema:common:v1#/$defs/token" }, { "type": "null" }] }
  },
  "required": ["schema_version", "event_id", "trace_id", "scope", "actor_ref", "target_ref", "quoted_target_ref", "event_class", "valence", "arousal", "vulnerability", "confidence", "occurred_at", "valid_until", "dedupe_key", "evidence_refs", "supersedes"],
  "additionalProperties": false
}
