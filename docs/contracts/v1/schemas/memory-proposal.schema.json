{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:companion:schema:memory-proposal:v1",
  "title": "memory.proposal.v1",
  "allOf": [
    {
      "$ref": "urn:companion:schema:common:v1#/$defs/request"
    }
  ],
  "properties": {
    "schema_version": {
      "const": "memory.proposal.v1"
    },
    "capability_id": {
      "const": "memory.proposal.submit"
    },
    "payload": {
      "type": "object",
      "properties": {
        "namespace": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "visibility": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "purpose": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "proposal_id": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "operation": {
          "enum": [
            "add",
            "correct",
            "retract",
            "no_op"
          ]
        },
        "target_atom_id": {
          "anyOf": [
            {
              "$ref": "urn:companion:schema:common:v1#/$defs/token"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "subject": {
          "$ref": "urn:companion:schema:common:v1#/$defs/subject"
        },
        "predicate": {
          "$ref": "urn:companion:schema:common:v1#/$defs/semantic"
        },
        "object": {},
        "qualifiers": {
          "type": "object",
          "default": {}
        },
        "polarity": {
          "enum": [
            "affirmed",
            "negated",
            "unknown"
          ]
        },
        "attribution": {
          "enum": [
            "user",
            "third_party",
            "bot",
            "unknown"
          ],
          "default": "unknown"
        },
        "representation": {
          "$ref": "urn:companion:schema:common:v1#/$defs/semantic"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:companion:schema:common:v1#/$defs/evidence"
          }
        },
        "valid_from": {
          "anyOf": [
            {
              "$ref": "urn:companion:schema:common:v1#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_to": {
          "anyOf": [
            {
              "$ref": "urn:companion:schema:common:v1#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "retention": {
          "enum": [
            "session",
            "short",
            "durable",
            "protected"
          ]
        },
        "defer_until_boundary": {
          "type": "boolean",
          "default": false
        },
        "types": {
          "type": "array",
          "items": {
            "$ref": "urn:companion:schema:common:v1#/$defs/token"
          },
          "uniqueItems": true
        },
        "extensions": {
          "$ref": "urn:companion:schema:common:v1#/$defs/extensions"
        }
      },
      "required": [
        "namespace",
        "visibility",
        "purpose",
        "proposal_id",
        "operation",
        "target_atom_id",
        "expected_revision"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "add",
                  "correct"
                ]
              }
            }
          },
          "then": {
            "required": [
              "subject",
              "predicate",
              "object",
              "retention"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "correct",
                  "retract"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "target_atom_id": {
                "$ref": "urn:companion:schema:common:v1#/$defs/token"
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "target_atom_id": {
                "type": "null"
              },
              "expected_revision": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "no_op"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "maxItems": 0
              },
              "defer_until_boundary": {
                "const": false
              }
            }
          },
          "else": {
            "required": [
              "evidence_refs"
            ],
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "idempotency_key": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    }
  },
  "required": [
    "idempotency_key"
  ],
  "unevaluatedProperties": false
}
