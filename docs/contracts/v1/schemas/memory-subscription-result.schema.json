{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:companion:schema:memory-subscription-result:v1",
  "title": "memory.subscription-result.v1; control success is not fact commit",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "memory.subscription-result.v1"
    },
    "capability_id": {
      "enum": [
        "memory.changed.subscribe",
        "memory.changed.ack",
        "memory.changed.resync"
      ]
    },
    "capability_version": {
      "const": "1.0"
    },
    "provider_id": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "provider_generation": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "request_id": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "trace_id": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "status": {
      "enum": [
        "succeeded",
        "rejected",
        "permission_denied",
        "unavailable",
        "timeout",
        "uncertain",
        "failed",
        "cancelled"
      ]
    },
    "reason_code": {
      "anyOf": [
        {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        {
          "type": "null"
        }
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "degraded": {
      "const": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "urn:companion:schema:common:v1#/$defs/token"
      }
    },
    "output": {}
  },
  "required": [
    "schema_version",
    "capability_id",
    "capability_version",
    "provider_id",
    "provider_generation",
    "request_id",
    "trace_id",
    "status",
    "reason_code",
    "retryable",
    "degraded",
    "warnings",
    "output"
  ],
  "additionalProperties": false,
  "$defs": {
    "bound": {
      "type": "object",
      "properties": {
        "subscription_id": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "subscriber_generation": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "binding": {
          "$ref": "urn:companion:schema:memory-stream:v1#/$defs/binding"
        },
        "limits": {
          "$ref": "urn:companion:schema:memory-stream:v1#/$defs/limits"
        },
        "expires_at": {
          "$ref": "urn:companion:schema:common:v1#/$defs/time"
        },
        "subscription_state": {
          "enum": [
            "live",
            "resync_required"
          ]
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "urn:companion:schema:common:v1#/$defs/token"
            },
            {
              "type": "null"
            }
          ]
        },
        "resync_reason": {
          "anyOf": [
            {
              "$ref": "urn:companion:schema:common:v1#/$defs/token"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "subscription_id",
        "subscriber_generation",
        "binding",
        "limits",
        "expires_at",
        "subscription_state",
        "cursor",
        "resync_reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "subscription_state": {
                "const": "live"
              }
            }
          },
          "then": {
            "properties": {
              "cursor": {
                "$ref": "urn:companion:schema:common:v1#/$defs/token"
              },
              "resync_reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "cursor": {
                "type": "null"
              },
              "resync_reason": {
                "$ref": "urn:companion:schema:common:v1#/$defs/token"
              }
            }
          }
        }
      ]
    },
    "acknowledged": {
      "type": "object",
      "properties": {
        "subscription_id": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "subscriber_generation": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "lease_id": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "batch"
                },
                "batch_id": {
                  "$ref": "urn:companion:schema:common:v1#/$defs/token"
                }
              },
              "required": [
                "kind",
                "batch_id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "snapshot"
                },
                "snapshot_id": {
                  "$ref": "urn:companion:schema:common:v1#/$defs/token"
                },
                "completion_token": {
                  "$ref": "urn:companion:schema:common:v1#/$defs/token"
                }
              },
              "required": [
                "kind",
                "snapshot_id",
                "completion_token"
              ],
              "additionalProperties": false
            }
          ]
        },
        "ack_state": {
          "enum": [
            "accepted",
            "already_accepted"
          ]
        },
        "subscription_state": {
          "enum": [
            "live",
            "resyncing"
          ]
        },
        "acknowledged_cursor": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "projection_generation": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        }
      },
      "required": [
        "subscription_id",
        "subscriber_generation",
        "lease_id",
        "target",
        "ack_state",
        "subscription_state",
        "acknowledged_cursor",
        "projection_generation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "target": {
                "properties": {
                  "kind": {
                    "const": "snapshot"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "subscription_state": {
                "const": "live"
              }
            }
          }
        }
      ]
    },
    "snapshotPage": {
      "type": "object",
      "properties": {
        "subscription_id": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "subscriber_generation": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "snapshot": {
          "$ref": "urn:companion:schema:memory-stream:v1#/$defs/snapshot"
        },
        "page_id": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "page_cursor": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "urn:companion:schema:memory-stream:v1#/$defs/snapshotItem"
          }
        },
        "next_page_cursor": {
          "anyOf": [
            {
              "$ref": "urn:companion:schema:common:v1#/$defs/token"
            },
            {
              "type": "null"
            }
          ]
        },
        "completion": {
          "anyOf": [
            {
              "$ref": "urn:companion:schema:memory-stream:v1#/$defs/completion"
            },
            {
              "type": "null"
            }
          ]
        },
        "activation_lease": {
          "anyOf": [
            {
              "$ref": "urn:companion:schema:memory-stream:v1#/$defs/lease"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "subscription_id",
        "subscriber_generation",
        "snapshot",
        "page_id",
        "page_cursor",
        "items",
        "next_page_cursor",
        "completion",
        "activation_lease"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "next_page_cursor": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "completion": {
                "$ref": "urn:companion:schema:memory-stream:v1#/$defs/completion"
              },
              "activation_lease": {
                "$ref": "urn:companion:schema:memory-stream:v1#/$defs/lease"
              }
            }
          },
          "else": {
            "properties": {
              "completion": {
                "type": "null"
              },
              "activation_lease": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "reason_code": {
            "type": "null"
          },
          "retryable": {
            "const": false
          }
        },
        "oneOf": [
          {
            "properties": {
              "capability_id": {
                "const": "memory.changed.subscribe"
              },
              "output": {
                "$ref": "#/$defs/bound"
              }
            }
          },
          {
            "properties": {
              "capability_id": {
                "const": "memory.changed.ack"
              },
              "output": {
                "$ref": "#/$defs/acknowledged"
              }
            }
          },
          {
            "properties": {
              "capability_id": {
                "const": "memory.changed.resync"
              },
              "output": {
                "$ref": "#/$defs/snapshotPage"
              }
            }
          }
        ]
      },
      "else": {
        "properties": {
          "reason_code": {
            "$ref": "urn:companion:schema:common:v1#/$defs/token"
          },
          "output": {
            "type": "null"
          }
        }
      }
    }
  ]
}
