{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:companion:schema:memory-stream:v1",
  "title": "Shared subscription control vocabulary; review only",
  "$defs": {
    "limits": {
      "type": "object",
      "properties": {
        "max_batch_items": {
          "type": "integer",
          "minimum": 1
        },
        "max_batch_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_inflight_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_inflight_batches": {
          "type": "integer",
          "minimum": 1
        },
        "lease_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_retry_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "max_snapshot_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_staging_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_retained_log_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "recovery_deadline_at": {
          "$ref": "urn:companion:schema:common:v1#/$defs/time"
        }
      },
      "required": [
        "max_batch_items",
        "max_batch_bytes",
        "max_inflight_bytes",
        "max_inflight_batches",
        "lease_ms",
        "max_retry_attempts",
        "max_snapshot_bytes",
        "max_staging_bytes",
        "max_retained_log_bytes",
        "recovery_deadline_at"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "subscriber_ref": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "owner_ref": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "namespace": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "purpose": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "projection_kind": {
          "const": "references"
        },
        "view_kind": {
          "enum": [
            "current_projection",
            "notifications"
          ]
        },
        "change_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "added",
              "corrected",
              "retracted",
              "expired"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "view_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authorization_revision": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "policy_revision": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "lineage_id": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "retention_epoch": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "contract_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "subscriber_ref",
        "owner_ref",
        "namespace",
        "purpose",
        "projection_kind",
        "view_kind",
        "change_kinds",
        "view_fingerprint",
        "authorization_revision",
        "policy_revision",
        "lineage_id",
        "retention_epoch",
        "contract_fingerprint"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "view_kind": {
                "const": "current_projection"
              }
            }
          },
          "then": {
            "properties": {
              "change_kinds": {
                "minItems": 4,
                "maxItems": 4
              }
            }
          }
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "snapshot_epoch": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "binding": {
          "$ref": "urn:companion:schema:memory-stream:v1#/$defs/binding"
        },
        "memory_revision": {
          "$ref": "urn:companion:schema:common:v1#/$defs/revision"
        },
        "tail_start_cursor": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "expires_at": {
          "$ref": "urn:companion:schema:common:v1#/$defs/time"
        }
      },
      "required": [
        "snapshot_id",
        "snapshot_epoch",
        "binding",
        "memory_revision",
        "tail_start_cursor",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "snapshotItem": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "item_kind": {
              "const": "fact_ref"
            },
            "atom_id": {
              "$ref": "urn:companion:schema:common:v1#/$defs/token"
            },
            "atom_revision": {
              "type": "integer",
              "minimum": 1
            },
            "memory_revision": {
              "$ref": "urn:companion:schema:common:v1#/$defs/revision"
            },
            "fact_status": {
              "const": "active"
            }
          },
          "required": [
            "item_kind",
            "atom_id",
            "atom_revision",
            "memory_revision",
            "fact_status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "item_kind": {
              "const": "tombstone"
            },
            "atom_id": {
              "$ref": "urn:companion:schema:common:v1#/$defs/token"
            },
            "atom_revision": {
              "type": "integer",
              "minimum": 1
            },
            "memory_revision": {
              "$ref": "urn:companion:schema:common:v1#/$defs/revision"
            },
            "change_kind": {
              "enum": [
                "retracted",
                "expired"
              ]
            }
          },
          "required": [
            "item_kind",
            "atom_id",
            "atom_revision",
            "memory_revision",
            "change_kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "lease": {
      "type": "object",
      "properties": {
        "lease_id": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "expires_at": {
          "$ref": "urn:companion:schema:common:v1#/$defs/time"
        }
      },
      "required": [
        "lease_id",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "subscriptionTarget": {
      "type": "object",
      "properties": {
        "subscription_id": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "subscriber_generation": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        }
      },
      "required": [
        "subscription_id",
        "subscriber_generation"
      ],
      "additionalProperties": false
    },
    "completion": {
      "type": "object",
      "properties": {
        "completion_token": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "tail_until_cursor": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        }
      },
      "required": [
        "completion_token",
        "tail_until_cursor"
      ],
      "additionalProperties": false
    }
  }
}
