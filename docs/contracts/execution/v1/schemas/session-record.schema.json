{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:companion:schema:session-record:v1",
  "title": "companion.session.v1 authorized session snapshot, not a join or resume command",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "companion.session.v1"
    },
    "session_id": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$",
      "maxLength": 256
    },
    "scope": {
      "$ref": "urn:companion:schema:runtime-scope:v1"
    },
    "owner_ref": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "controller_generation": {
      "$ref": "urn:companion:schema:common:v1#/$defs/token"
    },
    "persona_binding_revision": {
      "$ref": "urn:companion:schema:common:v1#/$defs/revision"
    },
    "phase": {
      "enum": [
        "requested",
        "invited",
        "joined",
        "active",
        "paused",
        "reconnecting",
        "ending",
        "ended",
        "declined",
        "expired",
        "failed"
      ]
    },
    "session_revision": {
      "$ref": "urn:companion:schema:common:v1#/$defs/revision"
    },
    "participants_ref": {
      "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
    },
    "capability_grants_ref": {
      "anyOf": [
        {
          "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "context_ref": {
      "anyOf": [
        {
          "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "context_revision": {
      "$ref": "urn:companion:schema:common:v1#/$defs/revision"
    },
    "checkpoint_ref": {
      "anyOf": [
        {
          "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "anyOf": [
        {
          "$ref": "urn:companion:schema:common:v1#/$defs/time"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_activity_at": {
      "anyOf": [
        {
          "$ref": "urn:companion:schema:common:v1#/$defs/time"
        },
        {
          "type": "null"
        }
      ]
    },
    "expires_at": {
      "$ref": "urn:companion:schema:common:v1#/$defs/time"
    },
    "ended_at": {
      "anyOf": [
        {
          "$ref": "urn:companion:schema:common:v1#/$defs/time"
        },
        {
          "type": "null"
        }
      ]
    },
    "termination_reason": {
      "anyOf": [
        {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary_ref": {
      "anyOf": [
        {
          "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "kind",
    "scope",
    "owner_ref",
    "controller_generation",
    "persona_binding_revision",
    "phase",
    "session_revision",
    "participants_ref",
    "capability_grants_ref",
    "context_ref",
    "context_revision",
    "checkpoint_ref",
    "started_at",
    "last_activity_at",
    "expires_at",
    "ended_at",
    "termination_reason",
    "summary_ref"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "joined",
              "active",
              "paused",
              "reconnecting",
              "ending"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "started_at": {
            "$ref": "urn:companion:schema:common:v1#/$defs/time"
          },
          "capability_grants_ref": {
            "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "ended",
              "declined",
              "expired",
              "failed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "ended_at": {
            "$ref": "urn:companion:schema:common:v1#/$defs/time"
          },
          "termination_reason": {
            "$ref": "urn:companion:schema:common:v1#/$defs/token"
          }
        }
      },
      "else": {
        "properties": {
          "ended_at": {
            "type": "null"
          },
          "termination_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "ended"
          }
        }
      },
      "then": {
        "properties": {
          "started_at": {
            "$ref": "urn:companion:schema:common:v1#/$defs/time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "reconnecting"
          }
        }
      },
      "then": {
        "properties": {
          "checkpoint_ref": {
            "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
          }
        }
      }
    }
  ]
}
