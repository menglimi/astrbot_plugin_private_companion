{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:companion:schema:execution-common:v1",
  "title": "Public execution vocabulary, independent of Memory services",
  "$defs": {
    "reference": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$",
          "maxLength": 256
        },
        "ref": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "urn:companion:schema:common:v1#/$defs/token"
            },
            {
              "$ref": "urn:companion:schema:common:v1#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "ref",
        "revision"
      ],
      "additionalProperties": false
    },
    "correlation": {
      "type": "object",
      "properties": {
        "task_id": {
          "anyOf": [
            {
              "$ref": "urn:companion:schema:common:v1#/$defs/token"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_id": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "part_id": {
          "anyOf": [
            {
              "$ref": "urn:companion:schema:common:v1#/$defs/token"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_id": {
          "anyOf": [
            {
              "$ref": "urn:companion:schema:common:v1#/$defs/token"
            },
            {
              "type": "null"
            }
          ]
        },
        "budget_ref": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "caused_by": {
          "type": "array",
          "items": {
            "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
          }
        }
      },
      "required": [
        "task_id",
        "attempt_id",
        "part_id",
        "operation_id",
        "budget_ref",
        "caused_by"
      ],
      "additionalProperties": false
    },
    "effect": {
      "enum": [
        "not_applicable",
        "not_applied",
        "applied",
        "partial",
        "unknown"
      ]
    },
    "binding": {
      "type": "object",
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$",
          "maxLength": 256
        },
        "capability_version": {
          "const": "1.0"
        },
        "provider_id": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "provider_generation": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        }
      },
      "required": [
        "capability_id",
        "capability_version",
        "provider_id",
        "provider_generation"
      ],
      "additionalProperties": false
    },
    "occurrence": {
      "type": "object",
      "properties": {
        "schedule_id": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "occurrence_id": {
          "$ref": "urn:companion:schema:common:v1#/$defs/token"
        },
        "scheduled_for": {
          "$ref": "urn:companion:schema:common:v1#/$defs/time"
        }
      },
      "required": [
        "schedule_id",
        "occurrence_id",
        "scheduled_for"
      ],
      "additionalProperties": false
    },
    "wait": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "event",
            "operation",
            "timer",
            "children"
          ]
        },
        "condition_ref": {
          "anyOf": [
            {
              "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at": {
          "$ref": "urn:companion:schema:common:v1#/$defs/time"
        }
      },
      "required": [
        "kind",
        "condition_ref",
        "expires_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "timer"
              }
            }
          },
          "then": {
            "properties": {
              "condition_ref": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "condition_ref": {
                "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
              }
            }
          }
        }
      ]
    },
    "retry": {
      "type": "object",
      "properties": {
        "basis": {
          "enum": [
            "proven_not_applied",
            "provider_idempotent"
          ]
        },
        "proof_ref": {
          "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
        },
        "expires_at": {
          "$ref": "urn:companion:schema:common:v1#/$defs/time"
        }
      },
      "required": [
        "basis",
        "proof_ref",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "precondition": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
        },
        "expected_revision": {
          "anyOf": [
            {
              "$ref": "urn:companion:schema:common:v1#/$defs/token"
            },
            {
              "$ref": "urn:companion:schema:common:v1#/$defs/revision"
            }
          ]
        }
      },
      "required": [
        "target",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "platform_accepted",
            "delivery_confirmed",
            "not_submitted",
            "submission_unknown",
            "delivery_failed"
          ]
        },
        "evidence_ref": {
          "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
        },
        "observed_at": {
          "$ref": "urn:companion:schema:common:v1#/$defs/time"
        }
      },
      "required": [
        "level",
        "evidence_ref",
        "observed_at"
      ],
      "additionalProperties": false
    }
  }
}
