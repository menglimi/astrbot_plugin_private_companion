{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:companion:fixture:execution-domain:v1",
  "title": "Fixture-only payload examples, not published domain contracts",
  "$defs": {
    "story-input": {
      "type": "object",
      "properties": {
        "project_ref": {
          "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "project_ref",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "story-output": {
      "type": "object",
      "properties": {
        "project_ref": {
          "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
        },
        "chunk_ref": {
          "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
        }
      },
      "required": [
        "project_ref",
        "chunk_ref"
      ],
      "additionalProperties": false
    },
    "delivery-input": {
      "type": "object",
      "properties": {
        "target_ref": {
          "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
        },
        "content_ref": {
          "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
        }
      },
      "required": [
        "target_ref",
        "content_ref"
      ],
      "additionalProperties": false
    },
    "session-input": {
      "type": "object",
      "properties": {
        "session_ref": {
          "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
        },
        "checkpoint_ref": {
          "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
        }
      },
      "required": [
        "session_ref",
        "checkpoint_ref"
      ],
      "additionalProperties": false
    },
    "session-output": {
      "type": "object",
      "properties": {
        "session_ref": {
          "$ref": "urn:companion:schema:execution-common:v1#/$defs/reference"
        },
        "phase": {
          "enum": [
            "active",
            "reconnecting"
          ]
        }
      },
      "required": [
        "session_ref",
        "phase"
      ],
      "additionalProperties": false
    }
  }
}
